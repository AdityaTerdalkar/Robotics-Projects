//Common Initializations for Constants and Variables
const byte Kp = 4;
const byte Kd = 2;
int readVal1, positionVal1, readVal2, positionVal2;
const byte analogPin1 = A1;
const byte analogPin2 = A15;
const byte junctionPulse = 20;
const byte dir1 = 22;
const byte dir2 = 24;
const byte dir3 = 38;
const byte dir4 = 40;
const byte pwm1 = 4;
const byte pwm2 = 5;
const byte pwm3 = 44;
const byte pwm4 = 46;
int junctionCount; //Variable used to count the number of "T" or "+" junctions 
int error1, lastError1, error2, lastError2;
int rightFrontMotorSpeed, rightRearMotorSpeed, leftFrontMotorSpeed, leftRearMotorSpeed;
const byte setPoint = 35;
int baseSpeed = 60; //Sets a Baseline PWM speed
int maxSpeed = 90; //Sets a Maximum PWM speed limit for better handling
int motorSpeed;


void setup() {
  Serial.begin(9600);

  pinMode(analogPin1, INPUT);
  pinMode(analogPin2, INPUT);
  pinMode(junctionPulse, INPUT);
  pinMode(dir1, OUTPUT);
  pinMode(dir2, OUTPUT);
  pinMode(pwm1, OUTPUT);
  pinMode(pwm2, OUTPUT);
  pinMode(dir3, OUTPUT);
  pinMode(dir4, OUTPUT);
  pinMode(pwm3, OUTPUT);
  pinMode(pwm4, OUTPUT);
  
  analogWrite(pwm1, 0);
  analogWrite(pwm2, 0);
  analogWrite(pwm3, 0);
  analogWrite(pwm4, 0);
  delay(5000);

  junctionCount = 0;

}

void loop() {
  
  readVal1 = analogRead(analogPin1);
  positionVal1 = ((float)readVal1 / 921) * 70;

   readVal2 = analogRead(analogPin2);
  positionVal2 = ((float)readVal2 / 921) * 70;

  if (positionVal1 <= 30) {
    moveLeft();
  }

  else if (positionVal1 <= 45) {
    moveForward();
  }
  
  else if (positionVal1 <= 70) {
    moveRight();
  }

  else if ((positionVal2 <= 10) && (positionVal1 > 70)) {
    adjustLeft();
  }

  else if ((positionVal2 <= 52) && (positionVal1 > 70)) {
    shiftLeft();
  }
  
  else if ((positionVal2 <= 80) && (positionVal1 > 70)){
    adjustRight();
  }

  else {
    wait();
  }

}

//Functions to read analog value from sensor and convert in a simpler format
void readVAL1() { 
  readVal1 = analogRead(analogPin1);
  positionVal1 = (((float)readVal1 / 921) * 70);
}

void readVAL2() {
  readVal2 = analogRead(analogPin2);
  positionVal2 = (((float)readVal2 / 921) * 70);
}

void moveLeft() {
  digitalWrite(dir1, 1);
  digitalWrite(dir2, 0);
  analogWrite(pwm1, 80);
  analogWrite(pwm2, 0);
  digitalWrite(dir3, 1);
  digitalWrite(dir4, 0);
  analogWrite(pwm3, 0);
  analogWrite(pwm4, 0); 
}

void moveRight() {
 digitalWrite(dir1, 1);
  digitalWrite(dir2, 0);
  analogWrite(pwm1, 0);
  analogWrite(pwm2, 80);
  digitalWrite(dir3, 1);
  digitalWrite(dir4, 0);
  analogWrite(pwm3, 0);
  analogWrite(pwm4, 0); 
}

//Function that incorporates speed control via PID controller for smooth and straight line following
void moveForward() {
  readVAL1();
  int error1 = positionVal1 - setPoint;
  if (positionVal1 < 10 && error1 < 0) {
    positionVal1 += 20;
  } else if (positionVal1 > 60 && error1 > 0) {
    positionVal1 -= 20;
  }
  float P = (Kp * error1);
  float D = (error1 - lastError1);
  int motorSpeed1 = ((Kp * error1) + (Kd * (error1 - lastError1)));
  lastError1 = error1;

  rightFrontMotorSpeed = baseSpeed + motorSpeed1;
  leftRearMotorSpeed = baseSpeed - motorSpeed1;

  if (rightFrontMotorSpeed > maxSpeed) rightFrontMotorSpeed = maxSpeed;
  if (leftRearMotorSpeed > maxSpeed) leftRearMotorSpeed = maxSpeed;

  if (rightFrontMotorSpeed < 0) rightFrontMotorSpeed = 0;
  if (leftRearMotorSpeed < 0) leftRearMotorSpeed = 0;

  digitalWrite(dir1, 1);
  digitalWrite(dir2, 0);
  
  analogWrite(pwm1, rightFrontMotorSpeed);
  analogWrite(pwm2, leftRearMotorSpeed);
  analogWrite(pwm3, 0);
  analogWrite(pwm4, 0); 
}

void adjustLeft() {
  digitalWrite(dir1, 1);
  digitalWrite(dir2, 0);
  analogWrite(pwm1, 0);
  analogWrite(pwm2, 0);
  digitalWrite(dir3, 1);
  digitalWrite(dir4, 0);
  analogWrite(pwm3, 80);
  analogWrite(pwm4, 0); 
}

void adjustRight() {
  digitalWrite(dir1, 1);
  digitalWrite(dir2, 0);
  analogWrite(pwm1, 0);
  analogWrite(pwm2, 0);
  digitalWrite(dir3, 1);
  digitalWrite(dir4, 0);
  analogWrite(pwm3, 0);
  analogWrite(pwm4, 80); 
}

void shiftLeft() {
readVAL2();
  int error2 = positionVal2 - setPoint;
  if (positionVal2 < 10 && error2 < 0) {
    positionVal2 += 20;
  } else if (positionVal2 > 60 && error2 > 0) {
    positionVal2 -= 20;
  }
  float P = (Kp * error2);
  float D = (error2 - lastError2);
  int motorSpeed2 = ((Kp * error2) + (Kd * (error1 - lastError2)));
  lastError2 = error2;

  leftFrontMotorSpeed = baseSpeed + motorSpeed2;
  rightRearMotorSpeed = baseSpeed - motorSpeed2;

  if (leftFrontMotorSpeed > maxSpeed) leftFrontMotorSpeed = maxSpeed;
  if (rightRearMotorSpeed > maxSpeed) rightRearMotorSpeed = maxSpeed;

  if (leftFrontMotorSpeed < 0) leftFrontMotorSpeed = 0;
  if (rightRearMotorSpeed < 0) rightRearMotorSpeed = 0;

  digitalWrite(dir3, 1);
  digitalWrite(dir4, 0);
  
  analogWrite(pwm1, 0);
  analogWrite(pwm2, 0);
  analogWrite(pwm3, leftFrontMotorSpeed);
  analogWrite(pwm4, rightRearMotorSpeed); 
}

void wait() {
  analogWrite(pwm1, 0);
  analogWrite(pwm2, 0);
  analogWrite(pwm3, 0);
  analogWrite(pwm4, 0); 
}
