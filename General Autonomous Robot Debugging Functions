//===========================================================================>

////////////////////////////////////////////////////////////////////
////////////////////// Initialize Methods///////////////////////////

// Initialize Motor Pins
void INIT_MotorPins()
{
  pinMode(M1_DIR, OUTPUT);
  pinMode(M2_DIR, OUTPUT);
  pinMode(M3_DIR, OUTPUT);
  pinMode(M4_DIR, OUTPUT);
  
  pinMode(M1_PWM, OUTPUT);
  pinMode(M1_PWM, OUTPUT);
  pinMode(M1_PWM, OUTPUT);
  pinMode(M1_PWM, OUTPUT);


  pinMode(GripVertical_DIR, OUTPUT);
  pinMode(GripVertical_PWM, OUTPUT);

  pinMode(GripPiston_DIR, OUTPUT);
  pinMode(GripPiston_PWM, OUTPUT);
}

void INIT_LimitSwitchPins()
{
  pinMode(FrontLeft_LIMIT,INPUT_PULLUP);
  pinMode(FrontRight_LIMIT,INPUT_PULLUP);

  pinMode(LeftFront_LIMIT,INPUT_PULLUP);
  pinMode(LeftBack_LIMIT,INPUT_PULLUP);

  pinMode(RightFront_LIMIT,INPUT_PULLUP);
  pinMode(RightBack_LIMIT,INPUT_PULLUP);

  pinMode(ClampBottom_LIMIT,INPUT_PULLUP);
  pinMode(ClampTop_LIMIT,INPUT_PULLUP);
}
////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////
///////////////////////// ENCODER FUNCTIONS ////////////////////////

// Initialize Motor PWM to 0
void INIT_MotorPins_Stop()
{
  analogWrite(M1_PWM,0);
  analogWrite(M2_PWM,0);
  analogWrite(M3_PWM,0);
  analogWrite(M4_PWM,0);

  analogWrite(GripVertical_PWM,0);
  analogWrite(GripPiston_PWM,0);
}

// Initialize Encode Pins
void INIT_EncoderPins()
{
  pinMode(2, INPUT_PULLUP);
  pinMode(3, INPUT_PULLUP);  
  attachInterrupt(0, ai0Back, RISING);
  attachInterrupt(1, ai1Back, RISING);

  
  pinMode(18, INPUT_PULLUP); 
  pinMode(19, INPUT_PULLUP);
  attachInterrupt(5, ai0Right, RISING);
  attachInterrupt(4, ai1Right, RISING);

  pinMode(20, INPUT_PULLUP);
  pinMode(21, INPUT_PULLUP);
  attachInterrupt(3, ai0Left, RISING);
  attachInterrupt(2, ai1Left, RISING);  // 20 
}

void CALCULATE_xy()
{
  botX = cm_per_tick * counterBack;

  botY = cm_per_tick * ((counterLeft+counterRight) / 2.0);
}

void RESET_EncoderX()
{
  tempBack    = 0;counterBack = 0;
  
  botX = 0;
}
void RESET_EncoderY()
{
  tempLeft  = 0;counterLeft  = 0;
  
  tempRight = 0;counterRight = 0;

  botY = 0;
}
void RESET_EncoderAll()
{
  RESET_EncoderX();
  RESET_EncoderY();
}


//////////////////////////////////////////
void ai0Back() {
  if (digitalRead(3) == LOW) {
    counterBack--;
  } else {
    counterBack++;
  }
}
void ai1Back() {
  if (digitalRead(2) == LOW) {
    counterBack++;
  } else {
    counterBack--;
  }
}
void ai0Right() {
  if (digitalRead(19) == LOW) {
    counterRight--;
  } else {
    counterRight++;
  }
}
void ai1Right() {
  if (digitalRead(18) == LOW) {
    counterRight++;
  } else {
    counterRight--;
  }
}
void ai0Left() {
  if (digitalRead(21) == LOW) {
    counterLeft++;
  } else {
    counterLeft--;
  }
}
void ai1Left() {
  if (digitalRead(20) == LOW) {
    counterLeft--;
  } else {
    counterLeft++;
  }
}
