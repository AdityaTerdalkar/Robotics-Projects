void FIX_LimitSwitches()
{
  FIX_LeftBack_LIMIT    =   !(digitalRead(LeftBack_LIMIT));
  FIX_RightFront_LIMIT  =   !(digitalRead(RightFront_LIMIT));
  FIX_RightBack_LIMIT   =   !(digitalRead(RightBack_LIMIT));
}

void PRINT_LimitSwitches()
{
  Serial.print("FrontLeft_LIMIT   (A0):");Serial.println(digitalRead(FrontLeft_LIMIT));
  Serial.print("FrontRight_LIMIT  (A1):");Serial.println(digitalRead(FrontRight_LIMIT));
  Serial.print("LeftFront_LIMIT   (A6):");Serial.println(digitalRead(LeftFront_LIMIT));
  Serial.print("LeftBack_LIMIT    (A7):");Serial.println(FIX_LeftBack_LIMIT);
  Serial.print("RightFront_LIMIT  (A2):");Serial.println(FIX_RightFront_LIMIT);
  Serial.print("RightBack_LIMIT   (A3):");Serial.println(FIX_RightBack_LIMIT);
  Serial.print("ClampBottom_LIMIT (A10):");Serial.println(digitalRead(ClampBottom_LIMIT));
  Serial.print("ClampTop_LIMIT    (A8):");Serial.println(digitalRead(ClampTop_LIMIT));

  Serial.println("\n\n=================================");
}



void PRINT_Encoder_Cm()
{
//    Serial.print("CounterLeft:");Serial.println(counterLeft);
  Serial.print("X Direction (Sideways):");Serial.print(botX);
  Serial.print("\t Y Direction (Forward) :");Serial.println(botY);

  Serial.println("\n\n=================================");
}
