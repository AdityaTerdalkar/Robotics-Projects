////////////////////////////////////////////////////////////////////
////////////////////// ATOMIC BASE DRIVE FUNTIONS  ////////////////////////

//=================Individual Drive
void DRIVE_M1(bool DIRECTION, int SPEED)
{
  digitalWrite(M1_DIR,DIRECTION);
  analogWrite(M1_PWM,SPEED);
}
void DRIVE_M2(bool DIRECTION, int SPEED)
{
  digitalWrite(M2_DIR,DIRECTION);
  analogWrite(M2_PWM,SPEED);
}
void DRIVE_M3(bool DIRECTION, int SPEED)
{
  digitalWrite(M3_DIR,DIRECTION);
  analogWrite(M3_PWM,SPEED);
}
void DRIVE_M4(bool DIRECTION, int SPEED)
{
  digitalWrite(M4_DIR,DIRECTION);
  analogWrite(M4_PWM,SPEED);
}

//====================Group Drive
void DRIVE_Forward(int SPEED_2,int SPEED_4)
{
  DRIVE_M2(HIGH,SPEED_2);
  DRIVE_M4(LOW,SPEED_4);
}
void DRIVE_Backward(int SPEED_2,int SPEED_4)
{
  DRIVE_M2(LOW,SPEED_2);
  DRIVE_M4(HIGH,SPEED_4);
}
void DRIVE_Left(int SPEED_1,int SPEED_3)
{
  DRIVE_M1(HIGH,SPEED_1);
  DRIVE_M3(LOW,SPEED_3);
}
void DRIVE_Right(int SPEED_1,int SPEED_3)
{
  DRIVE_M1(LOW,SPEED_1);
  DRIVE_M3(HIGH,SPEED_3);
}

void DRIVE_StraightStop()
{
  analogWrite(M2_PWM,0);
  analogWrite(M4_PWM,0);
}
void DRIVE_SideStop()
{
  analogWrite(M1_PWM,0);
  analogWrite(M3_PWM,0);
}
void DRIVE_Stop()
{
  analogWrite(M1_PWM,0);
  analogWrite(M2_PWM,0);
  analogWrite(M3_PWM,0);
  analogWrite(M4_PWM,0);
}
