////////////////////////////////////////////////////////////////////
////////////////// CUSTOM BASE DRIVE FUNCTIONS /////////////////////

void DRIVE_FRBL()
{
  DRIVE_Left(100,100);
  DRIVE_StraightStop();
}

void GRIPPER_Upwards(int SPEED)
{
  digitalWrite(GripVertical_DIR, LOW);
  analogWrite(GripVertical_PWM, SPEED);
}
void GRIPPER_Downwards(int SPEED)
{
  digitalWrite(GripVertical_DIR, HIGH);
  analogWrite(GripVertical_PWM, SPEED);
}

void Gripper_Close(int SPEED)
{
  digitalWrite(GripPiston_DIR,LOW);
  analogWrite(GripPiston_PWM, SPEED);
}
void Gripper_Open(int SPEED)
{
  digitalWrite(GripPiston_DIR,HIGH);
  analogWrite(GripPiston_PWM, SPEED);
}

