
//////////////// Encoder Variables /////////////////////
volatile long tempBack = 0, counterBack   = 0;
volatile long tempLeft  = 0, counterLeft  = 0;
volatile long tempRight = 0, counterRight = 0;

volatile double botY = 0.0;
volatile double botX = 0.0;

const double cm_per_tick = 2.0 * PI * 3 / 1200;
////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////
///////////////////////// DEFINING MOTOR DRIVER PINS////////////////
// Defining Motor DIR Pins
#define M1_DIR  38
#define M2_DIR  22
#define M3_DIR  40
#define M4_DIR  24

//Defining Motor PWM Pins
#define M1_PWM  44
#define M2_PWM  4
#define M3_PWM  46
#define M4_PWM  5

//Defining Grip Vertical Pins
#define GripVertical_DIR  28
#define GripVertical_PWM  7

//Defining Grip Piston Pins
#define GripPiston_DIR    26
#define GripPiston_PWM    6

//Defining Limit Switch Pins
#define FrontLeft_LIMIT   A0
#define FrontRight_LIMIT  A1

#define LeftFront_LIMIT   A7
#define LeftBack_LIMIT    A6

#define RightFront_LIMIT  A2
#define RightBack_LIMIT   A3

#define ClampBottom_LIMIT A10
#define ClampTop_LIMIT    A8

boolean FIX_LeftBack_LIMIT  = 0;
boolean FIX_RightFront_LIMIT    = 0;
boolean FIX_RightBack_LIMIT     = 0;

