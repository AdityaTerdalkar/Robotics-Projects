void setup()
{
  Serial.begin(9600);
  pinMode(2, INPUT_PULLUP);
  pinMode(3, INPUT_PULLUP);
  attachInterrupt(0, ai0Front, RISING);
  attachInterrupt(1, ai1Front, RISING);


  pinMode(18, INPUT_PULLUP);
  pinMode(19, INPUT_PULLUP);
  attachInterrupt(5, ai0Left, RISING);
  attachInterrupt(4, ai1Left, RISING);

  pinMode(20, INPUT_PULLUP);
  pinMode(21, INPUT_PULLUP);
  attachInterrupt(3, ai0Right, RISING);
  attachInterrupt(2, ai1Right, RISING);  // 50

 
  ////////////////////////// DRIV STUFF /////////////////////////
  ////////////////////// MOTOR DRIVE PINS //////////////////

  pinMode(f1, OUTPUT);
  pinMode(df1, OUTPUT);
  pinMode(f2, OUTPUT);
  pinMode(df2, OUTPUT);
  pinMode(s1, OUTPUT);
  pinMode(s2, OUTPUT);
  pinMode(ds1, OUTPUT);
  pinMode(ds2, OUTPUT);
  pinMode(mechdir, OUTPUT);
  pinMode(mechpwm, OUTPUT);
  pinMode(soldir, OUTPUT);
  pinMode(solpwm, OUTPUT);
  //////////////////////////// DRIVE DISABLE /////////////

  //turn the PID on
  xpid.SetMode(AUTOMATIC);
  ypid.SetMode(AUTOMATIC);
  hpid.SetMode(AUTOMATIC);
  //================================limit

  mechlimitup.setDebounceTime (50);
  mechlimitdown.setDebounceTime (50);


  Serial.println("=======================START ==================");
  Stop(); Stopmech ;
  delay(2000);

}


