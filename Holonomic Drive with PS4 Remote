#include <PS4Controller.h>
int s1 = 16;    //f and s pins are pwm
int ds1 = 17;

int s2 = 22;
int ds2 = 23;     //TX2

int f1 = 33;      //RX2
int df1 = 32;

int f2 = 13;
int df2 = 12;

int bm1 =27;      // dir
int dbm1 =14;   //pwm

int sol1 =5;
int piston1 =18;

int xlValue, ylValue, xrValue, yrValue, Xlvalue, Ylvalue, Xrvalue, Yrvalue;
unsigned long lastTimeStamp = 0;

void setup()
{
  pinMode(f1, OUTPUT);
  pinMode(df1, OUTPUT);
  pinMode(f2, OUTPUT);
  pinMode(df2, OUTPUT);
  pinMode(s1, OUTPUT);
  pinMode(s2, OUTPUT);
  pinMode(ds1, OUTPUT);
  pinMode(ds2, OUTPUT);
  pinMode(bm1, OUTPUT);
  pinMode(dbm1, OUTPUT);
  pinMode(sol1, OUTPUT);
  pinMode(piston1, OUTPUT);
  
  Serial.begin(230400);
  PS4.attach(onEvent);
  PS4.begin("E4:65:B8:28:B4:CC");
  Serial.println("Initialization ready!");

   //PS4.begin("24:DC:C3:48:61:58");
}

void loop()
{
  Serial.print("PS4.LStickX()");
  Serial.print(PS4.LStickX());
  vTaskDelete(NULL);
}

void onEvent() {

  if (PS4.data.button.l2) {
    Serial.println("L2 ");
    digitalWrite(bm1, 0);   //dir
    analogWrite(dbm1, PS4.data.analog.button.l2);     //pwm
  }
  else if (PS4.data.button.r2) {
    Serial.println("R2");
    digitalWrite(bm1, 1);     //dir
    analogWrite(dbm1, PS4.data.analog.button.r2);       //pwm
  }
  else{
    Serial.println("L Stopped");
    analogWrite(dbm1, 0);
  }

  if (PS4.data.button.up) {
    Serial.print("up - forw ");
    forw();
  }
  else if (PS4.data.button.down) {
    Serial.print("down - rev ");
    rev();
  }
  else if (PS4.data.button.left) {
    Serial.print("left ");
    left();
  }
  else if (PS4.data.button.right) {
    Serial.print("right ");
    right();
  }
   else if (PS4.data.button.l1) {
    Serial.println("L1");
    digitalWrite(sol1, 1);
    digitalWrite(piston1, 1);
  }

  else if (PS4.data.button.r1) {
    Serial.println("R1");
    digitalWrite(sol1, 0);
    digitalWrite(piston1, 0);
  }
   
  else if ((PS4.LStickX() < -20) && (abs(PS4.LStickY())< 64 )) {       //left
    xlValue = int(map(PS4.LStickX(), -128, 0,  -255, 0));
    Serial.println("rev s1 and s2 ");
    Serial.println(xlValue);
    analogWrite(s1, int(map(PS4.LStickX(), -128, 0,  255, 0)));
    digitalWrite(ds1, 1);
    analogWrite(s2, int(map(PS4.LStickX(), -128, 0,  255, 0)));
    digitalWrite(ds2, 0);

    analogWrite(f1, 0);
    analogWrite(f2, 0);
  }

  else if ((PS4.LStickX() > 20) && (abs(PS4.LStickY())< 64 )) {      //right
    Xlvalue = int(map(PS4.LStickX(), 0, 127, 0, 255));
    Serial.println("fr s1 and s2");
    Serial.println(Xlvalue);
    analogWrite(s1, int(map(PS4.LStickX(), 0, 127, 0, 255)));
    digitalWrite(ds1, 0);
    analogWrite(s2, int(map(PS4.LStickX(), 0, 127, 0, 255)));
    digitalWrite(ds2, 1);

    analogWrite(f1, 0);
    analogWrite(f2, 0);
  }

  else if ((PS4.LStickY() < -20) &&  (abs(PS4.LStickX())< 64 )){         //rev
    ylValue = int(map(PS4.LStickX(), -128, 0,  -255, 0));
    Serial.println("rev  f1 and f2  ");
    Serial.println(ylValue);
    analogWrite(f1, int(map(PS4.LStickY(), -128, 0,  255, 0)));
    digitalWrite(df1, 0);
    analogWrite(f2, int(map(PS4.LStickY(), -128, 0,  255, 0)));
    digitalWrite(df2, 1);

    analogWrite(s1, 0);
    analogWrite(s2, 0);
  }

  else if ((PS4.LStickY() > 20)  &&  (abs(PS4.LStickX())< 64 )) {          //forw
    Yrvalue = int(map(PS4.LStickY(), 0, 127, 0, 255));
    Serial.println("forw f1 and f2 ");
    Serial.println(Yrvalue);
    analogWrite(f1, int(map(PS4.LStickY(), 0, 127, 0, 255)));
    digitalWrite(df1, 1);
    analogWrite(f2, int(map(PS4.LStickY(), 0, 127, 0, 255)));
    digitalWrite(df2, 0);

    analogWrite(s1, 0);
    analogWrite(s2, 0);

  }
  else if (PS4.RStickY() > 10) {
    //Rotate
    Serial.println("Rotate 1");
    analogWrite(s1, int(map(PS4.RStickY(), 0, 127, 0, 100)));
    digitalWrite(ds1, 1);
    analogWrite(s2, int(map(PS4.RStickY(), 0, 127, 0, 100)));
    digitalWrite(ds2, 1);

    analogWrite(f1, int(map(PS4.RStickY(), 0, 127, 0, 100)));
    digitalWrite(df1, 1);
    analogWrite(f2, int(map(PS4.RStickY(), 0, 127, 0, 100)));
    digitalWrite(df2, 1);
  }
  else if (PS4.RStickY() < -10) {
    //Rotate
    Serial.println("Rotate 2");
    analogWrite(s1, int(map(PS4.RStickY(), -128, 0, 100, 0)));
    digitalWrite(ds1, 0);
    analogWrite(s2, int(map(PS4.RStickY(), -128, 0, 100, 0)));
    digitalWrite(ds2, 0);

    analogWrite(f1, int(map(PS4.RStickY(), -128, 0, 100, 0)));
    digitalWrite(df1, 0);
    analogWrite(f2, int(map(PS4.RStickY(), -128, 0, 100, 0)));
    digitalWrite(df2, 0);
  }

  else {
    Stop();
  }

  char msg_Str[200];
  sprintf(msg_Str, "%4d,%4d,%4d,%4d",
          xlValue, ylValue, xrValue, yrValue);

  if (millis() - lastTimeStamp > 50) {
    Serial.println(msg_Str);
    lastTimeStamp = millis();
  }
}

void forw() {
  Serial.println("forw  ");
  analogWrite(f1, 20);
  analogWrite(f2, 20);
  digitalWrite(df1, 1);
  digitalWrite(df2, 0);
}

void rev() {
  Serial.println("rev  ");
  analogWrite(f1, 20);
  analogWrite(f2, 20);
  digitalWrite(df1, 0);
  digitalWrite(df2, 0);
}

void left() {
  Serial.println("left  ");
  analogWrite(s1, 20);
  analogWrite(s2, 20);
  digitalWrite(ds1, 1);
  digitalWrite(ds2, 0);
}

void right() {  
  Serial.println("right  ");
  analogWrite(s1, 20);
  analogWrite(s2, 20);
  digitalWrite(ds1, 0);
  digitalWrite(ds2, 1);
}

void Stop() {
  Serial.println("stop  ");
  analogWrite(f1, 0);
  analogWrite(f2, 0);
  analogWrite(s1, 0);
  analogWrite(s2, 0);

}
