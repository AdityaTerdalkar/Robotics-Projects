#include <QMC5883LCompass.h>

QMC5883LCompass compass;

void setup() {
  Serial.begin(9600);
  compass.init();
}

void loop() {
  compass.read();
  
  byte a = compass.getAzimuth();
  byte b = compass.getBearing(a);
  char myArray[3];
  compass.getDirection(myArray, a);
  
  Serial.print(myArray[0]);
  Serial.print(myArray[1]);
  Serial.print(myArray[2]);
  Serial.print(" ");
  Serial.println(b);
//  Serial.println();
  
  delay(250);
}
